## Ignore Visual Studio temporary files, build results, and
## user-specific files.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Bb]in/
[Oo]bj/

# Uncomment if you have tasks that create the following files:
# *.log

# Visual Studio 2019/2022 config folder
.vs/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# Others
_ReSharper*/
*.ncrunch*
.*.crunch*.local.xml
*.DotSettings.user

# NuGet
*.nupkg
# The packages folder can be ignored because of PackageReference
**/packages/*
!**/packages/build/
!**/packages/repositories.config

# Microsoft Azure Web App publish settings
PublishProfiles/

# Visual Studio Code
.vscode/

# Windows image file caches
Thumbs.db
ehthumbs.db

# User-specific files
*.swp
*.bak
*.tmp

# IIS Express folder
.vsconfig
/SETUP_STEPS.md
/SETUP_CHECKLIST.md
/PIPELINE_FLOW.md
/GITHUB_ACTIONS_SETUP.md
/DEPLOYMENT_OPTIONS.md
/.github/BADGES.md
/DEPLOYMENT_TROUBLESHOOTING.md
SavePointBackend/build.log

# ---------- Terraform (infra/terraform) ----------
# Provider plugins / modules cache — recreated by `terraform init`
**/.terraform/

# Local state — we use the S3 backend, but ignore in case someone falls back
*.tfstate
*.tfstate.*

# Plan output written by `terraform plan -out=tfplan` in scripts/deploy-aws.sh
*.tfplan
tfplan

# Crash dumps
crash.log
crash.*.log

# Local-only override files (Terraform's documented "override.tf" convention)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

